# Transcription: set one or both. Groq is used first (fast, cheap); when it
# hits its rate limit (free tier: 20 requests/minute) requests go to OpenAI.
GROQ_API_KEY=
# Also used to format transcripts into readable paragraphs.
OPENAI_API_KEY=

# Optional
# PORT=8787
# FORMAT_MODEL=gpt-4.1-mini
# GROQ_MODEL=whisper-large-v3-turbo
# OPENAI_MODEL=whisper-1
# TRANSCRIBE_PROVIDER=mock   # fake transcripts, no key needed
